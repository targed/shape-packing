#!/bin/bash
#SBATCH --job-name=ShapePackOrchestrator
#SBATCH --ntasks=1
#SBATCH --nodes=1
#SBATCH --cpus-per-task=32
#SBATCH --time=00-13:00:00
#SBATCH --mail-type=begin,end,fail
#SBATCH --mail-user=ltkhg4@mst.edu
#SBATCH --export=all
#SBATCH --out=results/mill-%j.out

# Load Rust environment and compile before Anaconda breaks LD_LIBRARY_PATH
source "$HOME/.cargo/env"
cd /home/ltkhg4/Code/git/shape-packing/packer_rs
cargo build --release
cd ..

# Load system modules
module load anaconda/2023.07
module load gcc/12.2.0

# Force Python output to be completely unbuffered
export PYTHONUNBUFFERED=1

# Navigate to repo directory
cd /home/ltkhg4/Code/git/shape-packing

# Activate Python environment
source .venv/bin/activate

# Execute parallel loop with -u (unbuffered output)
python -u run_parallel_loop.py
