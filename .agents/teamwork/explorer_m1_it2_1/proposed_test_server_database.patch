+def test_update_solution_record_rejects_non_positive_metrics(mem_db: sqlite3.Connection):
+    """Verify that zero and negative metrics are rejected, preventing problem poisoning."""
+    cursor = mem_db.cursor()
+    cursor.execute(
+        "INSERT INTO problems (id, inner_token, container_token, n, best_s) VALUES ('p_pos', '3', '3', 1, 5.0)"
+    )
+    mem_db.commit()
+
+    assert not update_solution_record(mem_db, "p_pos", "w1", "alice", 0.0, [0.0])
+    assert not update_solution_record(mem_db, "p_pos", "w1", "alice", -0.0, [0.0])
+    assert not update_solution_record(mem_db, "p_pos", "w1", "alice", -1.0, [0.0])
+    assert not update_solution_record(mem_db, "p_pos", "w1", "alice", -1e-5, [0.0])
+
+    # Verify best_s was not changed and remains 5.0
+    prob = get_problem(mem_db, "p_pos")
+    assert prob["best_s"] == pytest.approx(5.0)
+
+    # Verify subsequent valid improvement works (record was not poisoned)
+    assert update_solution_record(mem_db, "p_pos", "w1", "alice", 4.5, [0.0])
+    assert get_problem(mem_db, "p_pos")["best_s"] == pytest.approx(4.5)
+
+
+def test_update_solution_record_rejects_invalid_metric_types(mem_db: sqlite3.Connection):
+    """Verify that non-numeric types, booleans, and None return False without raising TypeError."""
+    cursor = mem_db.cursor()
+    cursor.execute(
+        "INSERT INTO problems (id, inner_token, container_token, n, best_s) VALUES ('p_types', '3', '3', 1, 5.0)"
+    )
+    mem_db.commit()
+
+    assert not update_solution_record(mem_db, "p_types", "w1", "alice", None, [0.0])
+    assert not update_solution_record(mem_db, "p_types", "w1", "alice", "3.0", [0.0])
+    assert not update_solution_record(mem_db, "p_types", "w1", "alice", True, [0.0])
+    assert not update_solution_record(mem_db, "p_types", "w1", "alice", False, [0.0])
+    assert not update_solution_record(mem_db, "p_types", "w1", "alice", [1.0], [0.0])
+
+
+def test_update_solution_record_rejects_invalid_coordinates(mem_db: sqlite3.Connection):
+    """Verify that non-list coordinates or coordinates with NaN/Inf/invalid types are rejected."""
+    cursor = mem_db.cursor()
+    cursor.execute(
+        "INSERT INTO problems (id, inner_token, container_token, n, best_s) VALUES ('p_coords', '3', '3', 1, 5.0)"
+    )
+    mem_db.commit()
+
+    assert not update_solution_record(mem_db, "p_coords", "w1", "alice", 4.0, None)
+    assert not update_solution_record(mem_db, "p_coords", "w1", "alice", 4.0, "not_a_list")
+    assert not update_solution_record(mem_db, "p_coords", "w1", "alice", 4.0, 123)
+    assert not update_solution_record(mem_db, "p_coords", "w1", "alice", 4.0, [float("nan")])
+    assert not update_solution_record(mem_db, "p_coords", "w1", "alice", 4.0, [1.0, float("inf"), 2.0])
+    assert not update_solution_record(mem_db, "p_coords", "w1", "alice", 4.0, [1.0, float("-inf"), 2.0])
+    assert not update_solution_record(mem_db, "p_coords", "w1", "alice", 4.0, [1.0, "str", 2.0])
+    assert not update_solution_record(mem_db, "p_coords", "w1", "alice", 4.0, [1.0, None, 2.0])
+    assert not update_solution_record(mem_db, "p_coords", "w1", "alice", 4.0, [1.0, True, 2.0])
+
+    cursor.execute("SELECT COUNT(*) FROM solutions WHERE problem_id = 'p_coords'")
+    assert cursor.fetchone()[0] == 0
+
+
