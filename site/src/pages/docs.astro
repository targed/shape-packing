---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const docs = await getCollection('docs');
docs.sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const diataxisCategories: Record<string, string> = {
  'overview': 'Diataxis: Explanation',
  'architecture': 'Diataxis: Architecture',
  'how-to-run': 'Diataxis: How-To Guide',
  'problem-families': 'Diataxis: Reference',
  'methodology': 'Diataxis: Reference',
  'verification-and-metrics': 'Diataxis: Reference',
};
---

<BaseLayout title="Documentation | Shape Packing">
  <div class="max-w-5xl mx-auto space-y-8">
    <div class="space-y-3 border-b border-hairline pb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-surface-elevated text-blueprint-light border border-hairline text-xs font-mono">
        <span class="w-2 h-2 rounded-md bg-blueprint-light"></span>
        Diataxis Documentation Framework
      </div>
      <h1 class="text-3xl font-bold font-display text-slate-100 tracking-tight">System Documentation</h1>
      <p class="text-sm text-slate-400 max-w-2xl leading-relaxed">
        Guides, system architecture details, running instructions, and mathematical verification specs organized by the Diataxis technical documentation structure.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {docs.map((doc) => (
        <a
          href={`${base}/docs/${doc.slug}`}
          class="group p-6 rounded-lg bg-surface border border-hairline hover:border-blueprint/50 transition-colors flex flex-col justify-between space-y-4"
        >
          <div class="space-y-2">
            <div>
              <span class="font-mono text-[10px] uppercase tracking-wider text-blueprint-light bg-surface-elevated border border-hairline px-2 py-0.5 rounded-md inline-block">
                {diataxisCategories[doc.slug] || `Guide 0${doc.data.order || 1}`}
              </span>
            </div>
            <h2 class="text-xl font-bold font-display text-slate-100 group-hover:text-blueprint-light transition-colors">
              {doc.data.title}
            </h2>
            <p class="text-xs text-slate-300 leading-relaxed">
              {doc.data.description || 'System specification and documentation.'}
            </p>
          </div>
          <span class="text-xs font-semibold font-mono text-blueprint-light flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
            Read Guide &rarr;
          </span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
