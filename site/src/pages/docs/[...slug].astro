---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await doc.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const docCategories: Record<string, string> = {
  'overview': 'Explanation',
  'architecture': 'Architecture',
  'how-to-run': 'How-To Guide',
  'problem-families': 'Catalog Reference',
  'methodology': 'Mathematical Reference',
  'verification-and-metrics': 'Verification Reference',
};
const category = docCategories[doc.slug] || 'Guide';
---

<BaseLayout title={`${doc.data.title} | Documentation`}>
  <div class="max-w-4xl mx-auto space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-4">
      <div class="flex items-center gap-2 text-xs font-mono text-slate-400">
        <a href={`${base}/docs`} class="text-slate-400 hover:text-blueprint-light transition-colors">Docs</a>
        <span class="text-slate-600">/</span>
        <span class="text-slate-200 font-medium">{doc.data.title}</span>
      </div>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-surface-elevated text-blueprint-light border border-hairline text-xs font-mono self-start sm:self-auto">
        <span class="text-slate-400">Category:</span>
        <span class="text-slate-200 font-semibold">{category}</span>
      </div>
    </div>

    <div class="bg-surface border border-hairline rounded-lg p-6 sm:p-8">
      <article class="doc-article prose prose-invert max-w-none prose-headings:font-display prose-headings:text-slate-100 prose-headings:tracking-tight prose-p:text-slate-300 prose-p:leading-relaxed prose-a:text-blueprint-light hover:prose-a:text-blueprint prose-a:no-underline hover:prose-a:underline prose-code:text-blueprint-light prose-code:font-mono prose-code:bg-surface-elevated prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-sm prose-code:before:content-none prose-code:after:content-none prose-pre:bg-canvas prose-pre:border prose-pre:border-hairline prose-pre:rounded-lg prose-pre:p-4 prose-th:text-slate-200 prose-th:font-mono prose-th:border-b prose-th:border-hairline prose-td:text-slate-300 prose-td:border-b prose-td:border-hairline prose-hr:border-hairline prose-li:text-slate-300">
        <Content />
      </article>
    </div>

    <div class="border-t border-hairline pt-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <a
        href={`${base}/docs`}
        class="text-xs font-mono font-semibold text-slate-300 hover:text-white bg-surface-elevated hover:bg-surface-hover border border-hairline px-3.5 py-2 rounded-md transition-colors flex items-center gap-1.5"
      >
        <span>&larr;</span>
        <span>Back to Docs Hub</span>
      </a>
      <a
        href={`${base}/results`}
        class="text-xs font-mono font-semibold text-blueprint-light hover:text-white bg-blueprint/10 hover:bg-blueprint/20 border border-blueprint/30 px-3.5 py-2 rounded-md transition-colors flex items-center gap-1.5"
      >
        <span>View Results Dashboard</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .doc-article h1 {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: #f8fafc;
    letter-spacing: -0.02em;
    margin-top: 1.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .doc-article h2 {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #e2e8f0;
    letter-spacing: -0.015em;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .doc-article h3 {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: #cbd5e1;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .doc-article p {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 0.925rem;
    line-height: 1.7;
    color: #94a3b8;
    margin-top: 0.75rem;
    margin-bottom: 1rem;
  }
  .doc-article ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-top: 0.75rem;
    margin-bottom: 1.25rem;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 0.925rem;
    line-height: 1.7;
    color: #94a3b8;
  }
  .doc-article ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-top: 0.75rem;
    margin-bottom: 1.25rem;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 0.925rem;
    line-height: 1.7;
    color: #94a3b8;
  }
  .doc-article li {
    margin-bottom: 0.35rem;
    color: #cbd5e1;
  }
  .doc-article li strong {
    color: #f1f5f9;
  }
  .doc-article code:not(pre code) {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.8rem;
    color: #38bdf8;
    background-color: #1a2234;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
  }
  .doc-article pre {
    font-family: "IBM Plex Mono", monospace;
    font-size: 0.8rem;
    line-height: 1.6;
    background-color: #0b0f17;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 1.25rem;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    overflow-x: auto;
    color: #e2e8f0;
  }
  .doc-article table {
    width: 100%;
    margin-top: 1.25rem;
    margin-bottom: 1.5rem;
    font-size: 0.8rem;
    font-family: "IBM Plex Mono", monospace;
    border-collapse: collapse;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    overflow: hidden;
  }
  .doc-article th {
    background-color: #1a2234;
    color: #e2e8f0;
    font-weight: 600;
    text-align: left;
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .doc-article td {
    background-color: #111827;
    color: #94a3b8;
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .doc-article a {
    color: #38bdf8;
    text-decoration: none;
  }
  .doc-article a:hover {
    text-decoration: underline;
  }
  .doc-article blockquote {
    border-left: 3px solid #0284c7;
    padding-left: 1rem;
    margin: 1.25rem 0;
    font-style: italic;
    color: #94a3b8;
  }
  .doc-article hr {
    border-color: rgba(255, 255, 255, 0.08);
    margin: 2rem 0;
  }
  .mermaid-chart {
    background: #0b0f17;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 1.5rem;
    margin: 1.5rem 0;
    overflow-x: auto;
    display: flex;
    justify-content: center;
  }
  .mermaid-chart svg {
    max-width: 100%;
    height: auto;
  }
</style>

<script>
  import mermaid from 'mermaid';

  mermaid.initialize({
    startOnLoad: false,
    theme: 'dark',
    themeVariables: {
      darkMode: true,
      background: '#0b0f17',
      primaryColor: '#111827',
      primaryBorderColor: '#0284c7',
      primaryTextColor: '#f8fafc',
      lineColor: '#64748b',
      secondaryColor: '#1a2234',
      tertiaryColor: '#0b0f17',
      fontFamily: '"Space Grotesk", system-ui, sans-serif',
      fontSize: '13px',
    },
  });

  async function renderMermaidDiagrams() {
    const codeBlocks = document.querySelectorAll<HTMLElement>('pre code.language-mermaid, pre[data-language="mermaid"] code, pre.astro-code[data-language="mermaid"]');
    for (let i = 0; i < codeBlocks.length; i++) {
      const el = codeBlocks[i];
      const pre = (el.tagName.toLowerCase() === 'pre' ? el : el.closest('pre')) as HTMLElement | null;
      if (!pre || pre.dataset.mermaidRendered === 'true') continue;
      pre.dataset.mermaidRendered = 'true';

      const code = (el.tagName.toLowerCase() === 'pre' ? el.innerText : el.textContent)?.trim() || '';
      if (!code) continue;

      const container = document.createElement('div');
      container.className = 'mermaid-chart';
      const id = `mermaid-svg-${Date.now()}-${i}`;

      try {
        const { svg } = await mermaid.render(id, code);
        container.innerHTML = svg;
        pre.replaceWith(container);
      } catch (err) {
        console.warn('Mermaid render warning:', err);
      }
    }
  }

  renderMermaidDiagrams();
  document.addEventListener('astro:page-load', renderMermaidDiagrams);
</script>
