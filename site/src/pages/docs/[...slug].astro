---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await doc.render();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title={`${doc.data.title} | Documentation`}>
  <div class="max-w-4xl mx-auto space-y-8">
    <div class="flex items-center gap-2 text-xs text-slate-400">
      <a href={`${base}/docs`} class="hover:text-indigo-400">Docs</a>
      <span>/</span>
      <span class="text-slate-200 font-medium">{doc.data.title}</span>
    </div>

    <article class="prose prose-invert max-w-none prose-headings:text-white prose-a:text-indigo-400 hover:prose-a:text-indigo-300 prose-code:text-indigo-300 prose-pre:bg-slate-900 prose-pre:border prose-pre:border-slate-800">
      <Content />
    </article>

    <div class="border-t border-slate-800 pt-6 flex justify-between">
      <a href={`${base}/docs`} class="text-xs font-semibold text-slate-400 hover:text-white">&larr; Back to Docs Hub</a>
      <a href={`${base}/results`} class="text-xs font-semibold text-indigo-400 hover:text-indigo-300">View Results Dashboard &rarr;</a>
    </div>
  </div>
</BaseLayout>
