---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResultsTable from '../components/ResultsTable.astro';
import siteData from '../data/site_data.json';

const { families, problems } = siteData;

// Unique status values
const statusOptions = Array.from(new Set(problems.map(p => p.status)));
---

<BaseLayout title="Results Dashboard | Shape Packing">
  <div class="space-y-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-6">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Results Dashboard</h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          Explore {problems.length.toLocaleString()} benchmark packing bounds across {families.length} shape families.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-slate-900 border border-slate-800 text-slate-300">
          Total Entries: <strong class="text-indigo-400 ml-1">{problems.length.toLocaleString()}</strong>
        </span>
      </div>
    </div>

    <!-- Interactive Filters -->
    <div class="bg-slate-900/60 border border-slate-800 rounded-xl p-4 flex flex-col sm:flex-row gap-4 items-center justify-between">
      <div class="w-full sm:w-auto flex-1 flex flex-col sm:flex-row gap-3">
        <!-- Family Select -->
        <select id="family-filter" class="bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-indigo-500">
          <option value="">All Families ({families.length})</option>
          {families.map((f) => (
            <option value={f.slug}>{f.name} ({f.slug})</option>
          ))}
        </select>

        <!-- Status Select -->
        <select id="status-filter" class="bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-indigo-500">
          <option value="">All Statuses</option>
          <option value="proved_optimal">Proved Optimal</option>
          <option value="best_known">Best Known</option>
          <option value="trivial">Trivial</option>
        </select>

        <!-- Search Input -->
        <input
          type="text"
          id="search-input"
          placeholder="Filter by family or N..."
          class="bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-indigo-500 flex-1 min-w-[180px]"
        />
      </div>

      <button
        id="reset-filters"
        class="w-full sm:w-auto px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-300 border border-slate-700 transition-colors"
      >
        Reset Filters
      </button>
    </div>

    <!-- Table Container -->
    <div id="results-table-container">
      <ResultsTable problems={problems} limit={200} />
    </div>
  </div>

  <script is:inline define:vars={{ allProblems: problems }}>
    const familyFilter = document.getElementById('family-filter');
    const statusFilter = document.getElementById('status-filter');
    const searchInput = document.getElementById('search-input');
    const resetButton = document.getElementById('reset-filters');
    const container = document.getElementById('results-table-container');

    function applyFilters() {
      const fam = familyFilter.value.toLowerCase();
      const stat = statusFilter.value.toLowerCase();
      const query = searchInput.value.toLowerCase().trim();

      const rows = container.querySelectorAll('tbody tr');
      let visibleCount = 0;

      rows.forEach((tr) => {
        const text = tr.innerText.toLowerCase();
        const matchesFam = !fam || text.includes(fam);
        const matchesStat = !stat || text.includes(stat);
        const matchesQuery = !query || text.includes(query);

        if (matchesFam && matchesStat && matchesQuery) {
          tr.style.display = '';
          visibleCount++;
        } else {
          tr.style.display = 'none';
        }
      });
    }

    familyFilter?.addEventListener('change', applyFilters);
    statusFilter?.addEventListener('change', applyFilters);
    searchInput?.addEventListener('input', applyFilters);
    resetButton?.addEventListener('click', () => {
      if (familyFilter) familyFilter.value = '';
      if (statusFilter) statusFilter.value = '';
      if (searchInput) searchInput.value = '';
      applyFilters();
    });
  </script>
</BaseLayout>
