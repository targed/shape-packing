---
// site/src/pages/leaderboard.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import LeaderboardTable from '../components/LeaderboardTable.astro';
import LiveClusterStats from '../components/LiveClusterStats.astro';
import fs from 'node:fs';
import path from 'node:path';

let totalAttempts = 0;
let totalRecords = 0;
try {
  const siteData = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), 'src/data/site_data.json'), 'utf-8'));
  totalAttempts = siteData.summary?.total_slurm_attempts || 0;
  totalRecords = siteData.summary?.total_new_bests || 0;
} catch {
  // Graceful fallback if data file is absent
}
---

<BaseLayout title="Volunteer Leaderboard | Shape Packing Grid">
  <div class="space-y-8 max-w-5xl mx-auto">
    <div class="space-y-3 border-b border-hairline pb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-surface-elevated text-blueprint-light border border-hairline rounded-md text-xs font-mono">
        <span class="w-2 h-2 rounded-md bg-verify"></span>
        Distributed Volunteer Grid
      </div>
      <h1 class="text-3xl font-bold font-display text-slate-100 tracking-tight">Volunteer Leaderboard</h1>
      <p class="text-sm text-slate-400 max-w-2xl leading-relaxed">
        Live volunteer grid telemetry and contributor rankings. Every compute cycle runs geometric collision checks and gradient descent to push packing bounds forward.
      </p>
    </div>

    <LiveClusterStats initialAttempts={totalAttempts} initialRecords={totalRecords} />

    <LeaderboardTable />
  </div>
</BaseLayout>
