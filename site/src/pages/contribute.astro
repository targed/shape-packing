---
// site/src/pages/contribute.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import LivePackingCanvas from '../components/LivePackingCanvas.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Volunteer Compute Cockpit | Shape Packing Grid">
  <div class="space-y-8 max-w-5xl mx-auto">
    <!-- Header -->
    <div class="border-b border-hairline pb-6 space-y-4">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-surface-elevated text-verify-light border border-hairline text-xs font-mono font-medium">
        <span class="w-1.5 h-1.5 rounded-sm bg-verify-light"></span>
        Distributed Volunteer Grid
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight font-display">
        Volunteer Compute Cockpit
      </h1>
      <p class="text-sm sm:text-base text-slate-300 max-w-3xl leading-relaxed">
        Help explore unknown mathematical packings and break Erich Friedman benchmark bounds. Donate processing power directly in your browser or run the high-performance standalone binary. Both options submit verified solutions to the same shared coordinator grid.
      </p>

      <!-- Worker Choice Cards: Standalone vs In-Browser (Equal-Standing Architecture) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
        <!-- Option 1: Standalone Worker (Fastest) -->
        <div class="bg-surface border border-hairline rounded-lg p-5 space-y-3.5 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-surface-elevated text-blueprint-light border border-hairline text-xs font-mono font-bold uppercase tracking-wider">
                <svg class="w-3.5 h-3.5 text-blueprint-light flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Option 1: Standalone Worker (Fastest)
              </div>
              <span class="text-[11px] font-mono font-semibold text-slate-300 bg-surface-elevated px-2 py-0.5 rounded-md border border-hairline">
                Multi-Threaded
              </span>
            </div>

            <div>
              <h3 class="text-base font-bold text-white font-display">Pure Rust Standalone Binary</h3>
              <p class="text-xs text-slate-300 mt-1 leading-relaxed">
                Native multi-threaded Rayon engine (4+ CPU cores) with background daemon capability. Executes at peak hardware throughput with zero browser overhead.
              </p>
            </div>

            <div class="bg-canvas rounded-md p-3 border border-hairline font-mono text-xs text-slate-300 space-y-1">
              <div class="text-slate-500 text-[11px]"># CLI operations & daemon config:</div>
              <div><span class="text-blueprint-light">./shape-packing-worker</span></div>
              <div><span class="text-blueprint-light">./shape-packing-worker</span> edit <span class="text-slate-500"># open config in text editor</span></div>
              <div><span class="text-blueprint-light">./shape-packing-worker</span> reconfigure <span class="text-slate-500"># reset config & rerun wizard</span></div>
              <div><span class="text-blueprint-light">./shape-packing-worker</span> autostart enable</div>
            </div>
          </div>

          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a
              href="https://github.com/targed/shape-packing/releases"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 bg-blueprint hover:bg-blueprint-dark text-white rounded-md font-semibold text-xs transition-colors flex items-center gap-1.5 cursor-pointer font-mono"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              Download Releases &rarr;
            </a>
            <span class="text-[11px] text-slate-400 font-mono">Windows (.exe), Linux, macOS</span>
          </div>
        </div>

        <!-- Option 2: In-Browser Web Cruncher (Zero Install) -->
        <div class="bg-surface border border-hairline rounded-lg p-5 space-y-3.5 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-surface-elevated text-verify-light border border-hairline text-xs font-mono font-bold uppercase tracking-wider">
                <svg class="w-3.5 h-3.5 text-verify-light flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
                Option 2: In-Browser Web Cruncher (Zero Install)
              </div>
              <span class="text-[11px] font-mono font-semibold text-verify-light bg-surface-elevated px-2 py-0.5 rounded-md border border-hairline">
                Zero Install
              </span>
            </div>

            <div>
              <h3 class="text-base font-bold text-white font-display">Browser WebAssembly Engine</h3>
              <p class="text-xs text-slate-300 mt-1 leading-relaxed">
                Zero install Wasm engine running in dedicated background web workers. Solve packing problems in real time with continuous visual oscilloscope feedback in this tab.
              </p>
            </div>

            <div class="bg-canvas rounded-md p-3 border border-hairline font-mono text-xs text-slate-300 space-y-1">
              <div class="text-slate-500 text-[11px]"># In-browser execution features:</div>
              <div class="text-slate-300">Wasm SIMD-accelerated geometric shrinkage engine.</div>
              <div class="text-slate-400 text-[11px]">Configurable Web Worker thread pools for parallel crunching.</div>
              <div class="text-slate-400 text-[11px]">Real-time state streaming to architectural oscilloscope canvas.</div>
            </div>
          </div>

          <div class="pt-2">
            <a
              href="#web-cruncher"
              class="px-4 py-2 bg-surface-elevated hover:bg-surface-hover text-verify-light border border-hairline rounded-md font-semibold text-xs transition-colors inline-flex items-center gap-1.5 cursor-pointer font-mono"
            >
              <span>Use In-Browser Cruncher Below</span>
              <span>&darr;</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Unifying Architectural Banner -->
      <div class="p-4 rounded-lg bg-surface border border-hairline text-xs text-slate-300 flex items-start gap-3">
        <div class="w-2 h-2 rounded-sm bg-blueprint-light mt-1 flex-shrink-0"></div>
        <div class="space-y-1">
          <span class="font-bold text-slate-100 uppercase tracking-wider text-[11px] font-mono">Grid Architecture Note</span>
          <p class="text-slate-300 leading-relaxed text-xs">
            Both clients connect to the exact same coordinator grid, lease from the same problem queue, and contribute verified solutions to the public benchmark. They are complementary options.
          </p>
        </div>
      </div>
    </div>

    <!-- Main Grid: Visualizer & Controls -->
    <div id="web-cruncher" class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
      <!-- Live Canvas Stage -->
      <div class="space-y-2.5">
        <LivePackingCanvas />
      </div>

      <!-- Controls & Status -->
      <div class="bg-surface border border-hairline rounded-lg p-5 space-y-5">
        <!-- Form Inputs -->
        <div class="space-y-3.5">
          <div>
            <label for="worker-username" class="block text-xs font-mono font-semibold uppercase tracking-wider text-slate-300 mb-1">
              Volunteer Username
            </label>
            <input
              id="worker-username"
              type="text"
              class="w-full bg-surface-elevated border border-hairline rounded-md px-3 py-2 text-xs font-mono text-slate-100 focus:outline-none focus:border-blueprint"
              placeholder="e.g. web_volunteer"
              value="web_volunteer"
            />
          </div>

          <div>
            <label for="worker-server-url" class="block text-xs font-mono font-semibold uppercase tracking-wider text-slate-300 mb-1">
              Coordinator URL
            </label>
            <input
              id="worker-server-url"
              type="text"
              class="w-full bg-surface-elevated border border-hairline rounded-md px-3 py-2 text-xs font-mono text-slate-100 focus:outline-none focus:border-blueprint"
              placeholder="https://shape-packing-ggd4d5e8c2ctggam.eastus-01.azurewebsites.net"
              value="https://shape-packing-ggd4d5e8c2ctggam.eastus-01.azurewebsites.net"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <div>
              <label for="worker-cores" class="block text-xs font-mono font-semibold uppercase tracking-wider text-slate-300 mb-1">
                Threads
              </label>
              <select
                id="worker-cores"
                class="w-full bg-surface-elevated border border-hairline rounded-md px-2.5 py-2 text-xs font-mono text-slate-100 focus:outline-none focus:border-blueprint cursor-pointer"
              >
                <option value="1">1 Thread</option>
                <option value="2">2 Threads</option>
                <option value="4" selected>4 Threads</option>
                <option value="8">8 Threads</option>
                <option value="12">12 Threads</option>
                <option value="16">16 Threads</option>
              </select>
            </div>

            <div>
              <label for="worker-batch-size" class="block text-xs font-mono font-semibold uppercase tracking-wider text-slate-300 mb-1">
                Max Attempts
              </label>
              <select
                id="worker-batch-size"
                class="w-full bg-surface-elevated border border-hairline rounded-md px-2.5 py-2 text-xs font-mono text-slate-100 focus:outline-none focus:border-blueprint cursor-pointer"
              >
                <option value="100">100 att.</option>
                <option value="250">250 att.</option>
                <option value="500" selected>500 att.</option>
                <option value="1000">1,000 att.</option>
                <option value="2000">2,000 att.</option>
              </select>
            </div>

            <div>
              <label for="worker-pacing" class="block text-xs font-mono font-semibold uppercase tracking-wider text-slate-300 mb-1">
                Display Pacing
              </label>
              <select
                id="worker-pacing"
                class="w-full bg-surface-elevated border border-hairline rounded-md px-2.5 py-2 text-xs font-mono text-slate-100 focus:outline-none focus:border-blueprint cursor-pointer"
              >
                <option value="150">Fast (150ms)</option>
                <option value="800" selected>Balanced (0.8s)</option>
                <option value="1800">Showcase (1.8s)</option>
              </select>
            </div>
          </div>

        <!-- Start / Stop Actions -->
        <div class="flex gap-3">
          <button
            id="btn-start"
            class="flex-1 py-2.5 px-4 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-md transition-colors flex items-center justify-center gap-2 cursor-pointer font-mono"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Start Crunching
          </button>

          <button
            id="btn-stop"
            disabled
            class="flex-1 py-2.5 px-4 bg-surface-elevated text-slate-500 border border-hairline font-bold text-xs rounded-md transition-colors flex items-center justify-center gap-2 cursor-not-allowed font-mono"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" />
            </svg>
            Stop
          </button>
        </div>

        <!-- Telemetry Cards -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs uppercase font-semibold font-mono text-slate-300">Session Telemetry</span>
            <a href={`${base}/leaderboard`} class="text-[11px] font-mono font-semibold text-blueprint-light hover:underline">
              Cluster Leaderboard &rarr;
            </a>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-1">
            <div class="bg-canvas border border-hairline rounded-md p-3 flex flex-col">
              <span class="text-[10px] uppercase font-semibold text-slate-400 font-mono">Attempts</span>
              <span id="metric-attempts" class="text-base font-bold font-mono text-blueprint-light mt-1">0</span>
            </div>

            <div class="bg-canvas border border-hairline rounded-md p-3 flex flex-col">
              <span class="text-[10px] uppercase font-semibold text-slate-400 font-mono">Leases</span>
              <span id="metric-leases" class="text-base font-bold font-mono text-verify-light mt-1">0</span>
            </div>

            <div class="bg-canvas border border-hairline rounded-md p-3 flex flex-col">
              <span class="text-[10px] uppercase font-semibold text-slate-400 font-mono">Solutions</span>
              <span id="metric-records" class="text-base font-bold font-mono text-cadmium-light mt-1">0</span>
            </div>

            <div class="bg-canvas border border-hairline rounded-md p-3 flex flex-col">
              <span class="text-[10px] uppercase font-semibold text-slate-400 font-mono">Server Ping</span>
              <span id="metric-ping" class="text-base font-bold font-mono text-slate-300 mt-1">--</span>
            </div>
          </div>
        </div>

        <!-- Activity Log -->
        <div class="space-y-2">
          <div class="flex justify-between items-center text-xs font-mono">
            <div class="flex items-center gap-2">
              <span class="text-xs uppercase font-semibold text-slate-300">Session Activity Log</span>
              <span class="text-[10px] text-slate-400 hidden sm:inline">(Click entry to inspect state)</span>
            </div>
            <button id="btn-clear-log" class="text-[11px] text-slate-400 hover:text-slate-200 font-mono px-2 py-0.5 rounded-md border border-hairline bg-surface-elevated cursor-pointer transition">
              Clear
            </button>
          </div>
          <div
            id="worker-log"
            class="h-44 bg-canvas border border-hairline rounded-md p-2.5 font-mono text-[11px] text-slate-300 overflow-y-auto space-y-1"
          >
            <div class="text-slate-400 italic p-1">[System] Standby. Cruncher telemetry and intermediate packing states will stream here.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const usernameInput = document.getElementById('worker-username') as HTMLInputElement;
  const serverUrlInput = document.getElementById('worker-server-url') as HTMLInputElement;
  const coresSelect = document.getElementById('worker-cores') as HTMLSelectElement;
  const batchSizeSelect = document.getElementById('worker-batch-size') as HTMLSelectElement;
  const pacingSelect = document.getElementById('worker-pacing') as HTMLSelectElement;
  const startBtn = document.getElementById('btn-start') as HTMLButtonElement;
  const stopBtn = document.getElementById('btn-stop') as HTMLButtonElement;
  const clearLogBtn = document.getElementById('btn-clear-log') as HTMLButtonElement;
  const logBox = document.getElementById('worker-log') as HTMLDivElement;
  const metricAttempts = document.getElementById('metric-attempts') as HTMLSpanElement;
  const metricLeases = document.getElementById('metric-leases') as HTMLSpanElement;
  const metricRecords = document.getElementById('metric-records') as HTMLSpanElement;
  const metricPing = document.getElementById('metric-ping') as HTMLSpanElement;

  // Restore saved settings from localStorage
  if (localStorage.getItem('shape_packing_username') && usernameInput) {
    usernameInput.value = localStorage.getItem('shape_packing_username') || 'web_volunteer';
  }
  if (localStorage.getItem('shape_packing_coordinator_url') && serverUrlInput) {
    serverUrlInput.value = localStorage.getItem('shape_packing_coordinator_url') || 'https://shape-packing-ggd4d5e8c2ctggam.eastus-01.azurewebsites.net';
  }
  if (localStorage.getItem('shape_packing_cores') && coresSelect) {
    coresSelect.value = localStorage.getItem('shape_packing_cores') || '4';
  } else if (typeof navigator !== 'undefined' && navigator.hardwareConcurrency && coresSelect) {
    const hwCores = navigator.hardwareConcurrency;
    const recCores = Math.min(4, Math.max(1, hwCores > 2 ? hwCores - 1 : hwCores));
    coresSelect.value = String(recCores);
  }
  if (localStorage.getItem('shape_packing_batch_size') && batchSizeSelect) {
    batchSizeSelect.value = localStorage.getItem('shape_packing_batch_size') || '500';
  }
  if (localStorage.getItem('shape_packing_pacing') && pacingSelect) {
    pacingSelect.value = localStorage.getItem('shape_packing_pacing') || '800';
  }

  let workers: Worker[] = [];
  let totalAttempts = 0;
  let totalLeases = 0;
  let totalRecordsBroken = 0;
  let activeWorkerIds: string[] = [];
  const targetMap: Record<string, number> = {};
  const baseWorkerId = `wasm-worker-${Math.random().toString(36).substring(2, 9)}`;

  function appendLog(message: string, isHighlight: boolean = false) {
    if (!logBox) return;
    const time = new Date().toLocaleTimeString();
    const line = document.createElement('div');
    line.className = 'p-1 text-slate-300 font-mono text-[11px]';
    if (isHighlight) {
      line.className = 'p-1 text-cadmium-light font-bold font-mono text-[11px]';
    }
    line.textContent = `[${time}] ${message}`;
    logBox.appendChild(line);
    logBox.scrollTop = logBox.scrollHeight;
  }

  function addCalculationLog(data: {
    thread: number;
    problem: string;
    n: number;
    s: number;
    container_s?: number;
    target_s: number;
    coordinates: number[];
    inner_token: string;
    container_token: string;
    isRecord: boolean;
  }) {
    if (!logBox) return;
    const time = new Date().toLocaleTimeString();
    const row = document.createElement('div');
    row.className =
      'flex items-center justify-between p-1.5 rounded-md hover:bg-surface-hover cursor-pointer transition group border border-hairline';

    const left = document.createElement('div');
    left.className = 'flex items-center gap-1.5 truncate text-[11px]';

    const sStr = typeof data.s === 'number' && data.s > 0 ? data.s.toFixed(5) : '--';
    const targetStr = typeof data.target_s === 'number' && data.target_s > 0 ? data.target_s.toFixed(5) : '--';
    const recordTag = data.isRecord ? '<span class="text-cadmium-light font-bold">[RECORD]</span> ' : '';

    left.innerHTML = `<span class="text-slate-500">[${time}]</span> <span class="text-slate-400 font-semibold">[T${data.thread}]</span> <span>${recordTag}<strong class="text-blueprint-light">${data.problem}</strong>: s=<strong class="${data.isRecord ? 'text-cadmium-light' : 'text-verify-light'}">${sStr}</strong> <span class="text-slate-500">(target: ${targetStr})</span></span>`;

    const btn = document.createElement('button');
    btn.className =
      'px-2 py-0.5 rounded-md text-[10px] font-mono font-semibold bg-surface-elevated group-hover:bg-blueprint text-slate-300 group-hover:text-white transition flex items-center gap-1 flex-shrink-0 cursor-pointer border border-hairline';
    btn.textContent = 'Inspect';

    row.appendChild(left);
    row.appendChild(btn);

    row.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('update-live-packing', {
          detail: {
            problem: data.problem,
            n: data.n,
            s: data.s,
            container_s: data.container_s,
            coordinates: data.coordinates,
            inner_token: data.inner_token,
            container_token: data.container_token,
            status: `Inspecting [Calc s: ${sStr}]`,
            is_inspect: true,
          },
        })
      );
    });

    logBox.appendChild(row);
    logBox.scrollTop = logBox.scrollHeight;
  }

  if (clearLogBtn) {
    clearLogBtn.addEventListener('click', () => {
      if (logBox) logBox.innerHTML = '';
    });
  }

  function startCrunching() {
    const username = usernameInput?.value.trim() || 'web_volunteer';
    const serverUrl = serverUrlInput?.value.trim().replace(/\/$/, '') || 'https://shape-packing-ggd4d5e8c2ctggam.eastus-01.azurewebsites.net';
    const cores = parseInt(coresSelect?.value || '4', 10);
    const batchSize = parseInt(batchSizeSelect?.value || '500', 10);
    const pacingDelay = parseInt(pacingSelect?.value || '800', 10);

    localStorage.setItem('shape_packing_username', username);
    localStorage.setItem('shape_packing_coordinator_url', serverUrl);
    localStorage.setItem('shape_packing_cores', String(cores));
    localStorage.setItem('shape_packing_batch_size', String(batchSize));
    localStorage.setItem('shape_packing_pacing', String(pacingDelay));

    appendLog(`Connecting to coordinator at ${serverUrl} as '${username}' with ${cores} worker thread(s)...`);

    const wasmPath = `${window.location.origin}/shape-packing/wasm/packer_rs_bg.wasm`;
    workers = [];
    activeWorkerIds = [];

    for (let i = 0; i < cores; i++) {
      const threadId = cores === 1 ? baseWorkerId : `${baseWorkerId}-t${i + 1}`;
      activeWorkerIds.push(threadId);

      // Register with coordinator
      const pingStart = performance.now();
      fetch(`${serverUrl}/api/v1/workers/register`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          worker_id: threadId,
          username: username,
          cores: 1,
        }),
      })
        .then((res) => {
          const pingElapsed = Math.round(performance.now() - pingStart);
          if (metricPing) metricPing.textContent = `${pingElapsed} ms`;
          return res.json();
        })
        .then((reg) => {
          if (i === 0) {
            appendLog(`Registered with cluster (Assigned ID: ${reg.worker_id})`);
          }
        })
        .catch((err) => {
          if (i === 0) {
            if (metricPing) metricPing.textContent = 'Offline';
            appendLog(`Note: Register endpoint unavailable (${err.message}). Proceeding directly.`);
          }
        });

      // Spawn Web Worker for each core
      try {
        const w = new Worker(new URL('../lib/workers/wasm_packer_worker.ts', import.meta.url), {
          type: 'module',
        });

        w.postMessage({
          command: 'start',
          serverUrl,
          username,
          workerId: threadId,
          wasmUrl: wasmPath,
          batchSize,
          pacingDelay,
        });

        w.onmessage = (e) => {
          const data = e.data;
          if (data.type === 'ready') {
            if (i === 0) appendLog('Rust WebAssembly engine initialized successfully.');
          } else if (data.type === 'task_started') {
            totalLeases += 1;
            if (metricLeases) metricLeases.textContent = totalLeases.toLocaleString();
            targetMap[data.work.problem] = data.work.target_s;
            appendLog(`[T${i + 1}] Leased ${data.work.problem} (Target s: ${data.work.target_s.toFixed(5)})`);
            window.dispatchEvent(
              new CustomEvent('update-live-packing', {
                detail: {
                  problem: data.work.problem,
                  n: data.work.n,
                  s: data.work.target_s,
                  coordinates: [],
                  inner_token: data.work.inner_token,
                  container_token: data.work.container_token,
                  status: `Solving [T${i + 1}/${cores}]`,
                },
              })
            );
          } else if (data.type === 'iteration_complete') {
            const isRecord = data.success && typeof data.best_s === 'number' && data.best_s > 0;
            const targetS = targetMap[data.problem] || 0;

            addCalculationLog({
              thread: i + 1,
              problem: data.problem,
              n: data.n,
              s: data.best_s,
              container_s: data.container_s,
              target_s: targetS,
              coordinates: data.coordinates,
              inner_token: data.inner_token,
              container_token: data.container_token,
              isRecord,
            });

            window.dispatchEvent(
              new CustomEvent('update-live-packing', {
                detail: {
                  problem: data.problem,
                  n: data.n,
                  s: data.best_s,
                  container_s: data.container_s,
                  coordinates: data.coordinates,
                  inner_token: data.inner_token,
                  container_token: data.container_token,
                  status: `Optimizing [T${i + 1}/${cores}]`,
                },
              })
            );
          } else if (data.type === 'attempts_completed') {
            totalAttempts += data.count;
            if (metricAttempts) metricAttempts.textContent = totalAttempts.toLocaleString();
          } else if (data.type === 'record_beaten') {
            totalRecordsBroken += 1;
            if (metricRecords) metricRecords.textContent = totalRecordsBroken.toLocaleString();
            appendLog(`[RECORD] Verified solution for ${data.problem}: s = ${data.best_s.toFixed(5)}!`, true);
          } else if (data.type === 'idle') {
            appendLog(`[T${i + 1}] ${data.message}`);
          } else if (data.type === 'error') {
            appendLog(`[T${i + 1}] Error: ${data.error}`);
          }
        };

        workers.push(w);
      } catch (err: unknown) {
        const msg = err instanceof Error ? err.message : String(err);
        appendLog(`Failed to start Web Worker T${i + 1}: ${msg}`);
      }
    }

    if (startBtn) {
      startBtn.disabled = true;
      startBtn.className =
        'flex-1 py-2.5 px-4 bg-surface-elevated text-slate-500 border border-hairline font-bold text-xs rounded-md cursor-not-allowed font-mono';
    }
    if (stopBtn) {
      stopBtn.disabled = false;
      stopBtn.className =
        'flex-1 py-2.5 px-4 bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs rounded-md transition-colors flex items-center justify-center gap-2 cursor-pointer font-mono';
    }
  }

  function stopCrunching() {
    const serverUrl = serverUrlInput?.value.trim().replace(/\/$/, '') || 'https://shape-packing-ggd4d5e8c2ctggam.eastus-01.azurewebsites.net';

    workers.forEach((w) => {
      w.postMessage({ command: 'stop' });
      w.terminate();
    });
    workers = [];

    activeWorkerIds.forEach((id) => {
      fetch(`${serverUrl}/api/v1/workers/deregister`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ worker_id: id }),
      }).catch(() => {});
    });
    activeWorkerIds = [];

    appendLog('All worker threads stopped and deregistered from coordinator.');
    if (metricPing) metricPing.textContent = '--';

    if (startBtn) {
      startBtn.disabled = false;
      startBtn.className =
        'flex-1 py-2.5 px-4 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-md transition-colors flex items-center justify-center gap-2 cursor-pointer font-mono';
    }
    if (stopBtn) {
      stopBtn.disabled = true;
      stopBtn.className =
        'flex-1 py-2.5 px-4 bg-surface-elevated text-slate-500 border border-hairline font-bold text-xs rounded-md cursor-not-allowed font-mono';
    }
  }

  startBtn?.addEventListener('click', startCrunching);
  stopBtn?.addEventListener('click', stopCrunching);

  window.addEventListener('beforeunload', () => {
    if (workers.length > 0) {
      stopCrunching();
    }
  });
</script>
