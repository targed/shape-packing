---
import PackingVisual from './PackingVisual.astro';

interface Problem {
  id: string;
  problem_family: string;
  N: number;
  inner_shape: string;
  container_shape: string;
  best_value: number | null;
  status: string;
  source_url?: string;
  source_note?: string;
  solution?: any;
}

interface Props {
  problems: Problem[];
  limit?: number;
}

const { problems, limit = 100 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<div class="w-full space-y-4">
  <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-900/60 shadow-xl backdrop-blur-sm">
    <table class="w-full text-left text-sm text-slate-300">
      <thead class="bg-slate-950/80 text-xs uppercase text-slate-400 border-b border-slate-800 tracking-wider">
        <tr>
          <th scope="col" class="px-6 py-3.5 font-semibold">Family</th>
          <th scope="col" class="px-4 py-3.5 font-semibold text-center">N</th>
          <th scope="col" class="px-6 py-3.5 font-semibold text-right">Best Value (S)</th>
          <th scope="col" class="px-4 py-3.5 font-semibold text-center">Status</th>
          <th scope="col" class="px-6 py-3.5 font-semibold text-right">Visual / Source</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60 font-mono text-xs">
        {problems.slice(0, limit).map((p) => (
          <tr class="hover:bg-slate-800/40 transition-colors group">
            <td class="px-6 py-4 font-sans font-medium text-slate-200">
              <a href={`${base}/family/${p.problem_family}`} class="hover:text-indigo-400 transition-colors flex items-center gap-2">
                <span>{p.problem_family}</span>
                <svg class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </td>
            <td class="px-4 py-4 text-center font-semibold text-indigo-300">{p.N}</td>
            <td class="px-6 py-4 text-right font-semibold text-emerald-400">
              {p.best_value !== null && p.best_value !== undefined ? p.best_value.toFixed(5) : '—'}
            </td>
            <td class="px-4 py-4 text-center font-sans">
              {p.status === 'proved_optimal' && (
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  Optimal
                </span>
              )}
              {p.status === 'best_known' && (
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-sky-500/10 text-sky-400 border border-sky-500/20">
                  Best Known
                </span>
              )}
              {p.status === 'trivial' && (
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-slate-800 text-slate-400 border border-slate-700">
                  Trivial
                </span>
              )}
              {p.status !== 'proved_optimal' && p.status !== 'best_known' && p.status !== 'trivial' && (
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                  {p.status}
                </span>
              )}
            </td>
            <td class="px-6 py-4 text-right font-sans">
              <div class="flex items-center justify-end gap-3">
                {p.solution && (
                  <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-indigo-400 bg-indigo-500/10 px-2 py-0.5 rounded border border-indigo-500/20">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    Sol Visual
                  </span>
                )}
                {p.source_url ? (
                  <a
                    href={p.source_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs text-slate-400 hover:text-white transition-colors underline underline-offset-2"
                  >
                    Ref Page &rarr;
                  </a>
                ) : (
                  <span class="text-slate-600">&mdash;</span>
                )}
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {problems.length > limit && (
    <p class="text-xs text-slate-500 text-center">
      Showing first {limit} of {problems.length} records. Filter to refine.
    </p>
  )}
</div>
