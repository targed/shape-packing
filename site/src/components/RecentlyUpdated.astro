---
// site/src/components/RecentlyUpdated.astro
interface Props {
  initialRecent?: any[];
}

const { initialRecent = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

function formatDelta(diff: number | null | undefined): string {
  if (diff === null || diff === undefined) return "-";
  if (diff < -1e-6) return `${diff.toFixed(6)}`;
  if (Math.abs(diff) <= 1e-4) return "0.000000";
  return `+${diff.toFixed(6)}`;
}
---

<div id="recent-solutions-container" class="bg-surface border border-hairline rounded-lg p-5 space-y-4">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-4">
    <div>
      <div class="flex items-center gap-2">
        <h2 class="font-display text-lg font-bold text-white tracking-tight">Recently Updated Problems &amp; Verified Records</h2>
        <span class="inline-flex items-center px-2 py-0.5 rounded-sm text-[10px] font-mono font-semibold bg-surface-elevated text-blueprint-light border border-hairline">
          Live Stream
        </span>
      </div>
      <p class="text-xs text-slate-400 mt-0.5">
        Real-time telemetry feed of solutions verified by SAT collision checking and accepted into the catalog
      </p>
    </div>
    <div class="flex items-center gap-2 self-start sm:self-auto">
      <span id="recent-status-indicator" class="text-[11px] text-slate-400 font-mono">Connecting...</span>
      <button
        id="btn-refresh-recent"
        class="text-xs font-mono px-2.5 py-1 rounded-md bg-surface-elevated hover:bg-surface-hover text-slate-300 font-medium transition-colors border border-hairline cursor-pointer"
        title="Refresh recently updated solutions"
      >
        Refresh
      </button>
    </div>
  </div>

  <div class="overflow-x-auto border border-hairline rounded-md bg-canvas">
    <table class="w-full text-left text-xs text-slate-300">
      <thead class="font-mono text-xs text-slate-400 border-b border-hairline bg-surface-elevated tracking-wider">
        <tr>
          <th class="px-4 py-2.5 font-semibold">Problem</th>
          <th class="px-3 py-2.5 text-center font-semibold">N</th>
          <th class="px-4 py-2.5 text-right font-semibold">Solved Metric (s)</th>
          <th class="px-4 py-2.5 text-right font-semibold">Friedman Bound</th>
          <th class="px-4 py-2.5 text-right font-semibold">Improvement (Delta)</th>
          <th class="px-4 py-2.5 text-center font-semibold">Contributor</th>
          <th class="px-4 py-2.5 text-center font-semibold">Verified At</th>
        </tr>
      </thead>
      <tbody id="recent-solutions-tbody" class="divide-y divide-hairline font-mono text-xs">
        {initialRecent.length === 0 ? (
          <tr>
            <td colspan="7" class="px-4 py-6 text-center text-slate-400 font-mono">
              No solutions verified yet. Volunteer grid is ready for solver workers.
            </td>
          </tr>
        ) : (
          initialRecent.slice(0, 10).map((r) => (
              <tr class="hover:bg-surface-elevated/50 transition-colors">
                <td class="px-4 py-2.5 font-semibold text-slate-200">
                  <a href={`${base}/results?q=${r.problem_id}`} class="hover:text-blueprint-light transition-colors underline underline-offset-2">
                    {r.problem_id}
                  </a>
                </td>
                <td class="px-3 py-2.5 text-center font-bold text-blueprint-light">{r.n}</td>
                <td class="px-4 py-2.5 text-right font-bold text-cadmium">
                  {r.metric_s ? r.metric_s.toFixed(6) : "-"}
                </td>
                <td class="px-4 py-2.5 text-right text-slate-400">
                  {r.reference_s ? r.reference_s.toFixed(6) : "-"}
                </td>
                <td class="px-4 py-2.5 text-right font-semibold">
                  {r.diff !== null && r.diff !== undefined ? (
                    <span class={r.diff < -1e-6 ? "text-verify-light" : "text-slate-400"}>
                      {formatDelta(r.diff)}
                    </span>
                  ) : (
                    <span class="text-slate-500">-</span>
                  )}
                </td>
                <td class="px-4 py-2.5 text-center font-mono">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-sm text-[10px] font-medium bg-surface-elevated text-slate-300 border border-hairline">
                    {r.worker_username || "volunteer"}
                  </span>
                </td>
                <td class="px-4 py-2.5 text-center text-slate-400 font-mono text-[10px]">
                  {r.verified_at ? r.verified_at.split(" ")[1] || r.verified_at : "recent"}
                </td>
              </tr>
          ))
        )}
      </tbody>
    </table>
  </div>
</div>

<script>
  import { fetchRecentSolutions } from '../lib/api';

  const base = import.meta.env.BASE_URL.replace(/\/$/, "");
  const tbody = document.getElementById('recent-solutions-tbody');
  const statusIndicator = document.getElementById('recent-status-indicator');
  const refreshBtn = document.getElementById('btn-refresh-recent');

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  let pollTimer: number | null = null;

  function formatDeltaJs(diff: number | null | undefined): string {
    if (diff === null || diff === undefined) return '-';
    if (diff < -1e-6) return diff.toFixed(6);
    if (Math.abs(diff) <= 1e-4) return '0.000000';
    return '+' + diff.toFixed(6);
  }

  async function updateRecent() {
    const res = await fetchRecentSolutions(10);
    const now = new Date().toLocaleTimeString();

    if (res.ok && Array.isArray(res.data) && res.data.length > 0) {
      if (statusIndicator) {
        statusIndicator.textContent = 'Live \u2022 ' + now;
        statusIndicator.className = 'text-[11px] text-verify-light font-mono';
      }

      if (tbody) {
        tbody.innerHTML = '';
        for (const r of res.data) {
          const isBetter = r.diff !== null && r.diff !== undefined && r.diff < -1e-6;
          const deltaClass = isBetter ? 'text-verify-light' : 'text-slate-400';
          const verifiedTime = r.verified_at ? (r.verified_at.split(' ')[1] || r.verified_at) : 'recent';
          const metricText = r.metric_s ? Number(r.metric_s).toFixed(6) : '-';
          const refText = r.reference_s ? Number(r.reference_s).toFixed(6) : '-';
          const deltaText = formatDeltaJs(r.diff);
          const username = r.worker_username || 'volunteer';

          const safeProblemId = escapeHtml(r.problem_id || '');
          const safeUsername = escapeHtml(r.worker_username || 'volunteer');
          const safeTime = escapeHtml(verifiedTime);

          const tr = document.createElement('tr');
          tr.className = 'hover:bg-surface-elevated/50 transition-colors';
          tr.innerHTML =
            '<td class="px-4 py-2.5 font-semibold text-slate-200">' +
              '<a href="' + base + '/results?q=' + encodeURIComponent(r.problem_id) + '" class="hover:text-blueprint-light transition-colors underline underline-offset-2">' +
                safeProblemId +
              '</a>' +
            '</td>' +
            '<td class="px-3 py-2.5 text-center font-bold text-blueprint-light">' + r.n + '</td>' +
            '<td class="px-4 py-2.5 text-right font-bold text-cadmium">' + metricText + '</td>' +
            '<td class="px-4 py-2.5 text-right text-slate-400">' + refText + '</td>' +
            '<td class="px-4 py-2.5 text-right font-semibold ' + deltaClass + '">' + deltaText + '</td>' +
            '<td class="px-4 py-2.5 text-center font-mono">' +
              '<span class="inline-flex items-center px-2 py-0.5 rounded-sm text-[10px] font-medium bg-surface-elevated text-slate-300 border border-hairline">' +
                safeUsername +
              '</span>' +
            '</td>' +
            '<td class="px-4 py-2.5 text-center text-slate-400 font-mono text-[10px]">' + safeTime + '</td>';
          tbody.appendChild(tr);
        }
      }
    } else {
      if (statusIndicator) {
        statusIndicator.textContent = 'Snapshot Mode \u2022 ' + now;
        statusIndicator.className = 'text-[11px] text-slate-400 font-mono';
      }
    }

    scheduleNext();
  }

  function scheduleNext() {
    if (pollTimer) clearTimeout(pollTimer);
    pollTimer = window.setTimeout(updateRecent, 12000);
  }

  if (refreshBtn) {
    refreshBtn.addEventListener('click', () => {
      if (statusIndicator) statusIndicator.textContent = 'Refreshing...';
      updateRecent();
    });
  }

  updateRecent();
</script>
