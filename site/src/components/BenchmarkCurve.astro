---
interface Problem {
  id: string;
  problem_family: string;
  N: number;
  known_value: number | null;
  our_best_metric: number | null;
  comparison_status: string;
  status: string;
}

interface Props {
  problems: Problem[];
  familySlug: string;
  familyName?: string;
}

const { problems, familySlug, familyName } = Astro.props;

// Filter and sort plottable problems
const refPoints = problems
  .filter((p) => p.known_value !== null && typeof p.known_value === 'number' && !isNaN(p.known_value))
  .sort((a, b) => a.N - b.N);

const solverPoints = problems
  .filter((p) => p.our_best_metric !== null && typeof p.our_best_metric === 'number' && !isNaN(p.our_best_metric))
  .sort((a, b) => a.N - b.N);

const allValues = [
  ...refPoints.map((p) => p.known_value as number),
  ...solverPoints.map((p) => p.our_best_metric as number),
];

const allNs = [
  ...refPoints.map((p) => p.N),
  ...solverPoints.map((p) => p.N),
];

const minN = allNs.length > 0 ? Math.min(...allNs) : 1;
const maxN = allNs.length > 0 ? Math.max(...allNs) : 1;
const minVal = allValues.length > 0 ? Math.min(...allValues) : 0;
const maxVal = allValues.length > 0 ? Math.max(...allValues) : 1;

// Dimensions & Margins
const svgWidth = 840;
const svgHeight = 320;
const marginLeft = 60;
const marginRight = 30;
const marginTop = 30;
const marginBottom = 45;

const plotWidth = svgWidth - marginLeft - marginRight;
const plotHeight = svgHeight - marginTop - marginBottom;

const xMin = minN;
const xMax = maxN > minN ? maxN : minN + 1;
const xSpan = xMax - xMin || 1;

// y-axis starts at 0 for truthful proportional scale
const yMin = 0;
const yMax = maxVal > 0 ? maxVal * 1.08 : 1;
const ySpan = yMax - yMin || 1;

function getX(n: number): number {
  return marginLeft + ((n - xMin) / xSpan) * plotWidth;
}

function getY(val: number): number {
  return marginTop + plotHeight - ((val - yMin) / ySpan) * plotHeight;
}

// Generate Y Ticks (5 intervals)
const yTickCount = 5;
const yTicks = Array.from({ length: yTickCount + 1 }, (_, i) => {
  const val = yMin + (i / yTickCount) * (yMax - yMin);
  return {
    val,
    y: getY(val),
    label: val >= 10 ? val.toFixed(1) : val.toFixed(2),
  };
});

// Generate X Ticks
const nRange = maxN - minN;
let nStep = 5;
if (nRange <= 10) nStep = 1;
else if (nRange <= 20) nStep = 2;
else if (nRange <= 50) nStep = 5;
else nStep = 10;

const xTicks: { n: number; x: number }[] = [];
for (let n = Math.ceil(minN / nStep) * nStep; n <= maxN; n += nStep) {
  if (n >= minN) {
    xTicks.push({ n, x: getX(n) });
  }
}
if (xTicks.length === 0 || xTicks[0].n !== minN) {
  xTicks.unshift({ n: minN, x: getX(minN) });
}

// Build SVG Paths
const refPathD = refPoints.length > 0
  ? refPoints.map((p, i) => `${i === 0 ? 'M' : 'L'} ${getX(p.N).toFixed(2)} ${getY(p.known_value!).toFixed(2)}`).join(' ')
  : '';

const solverPathD = solverPoints.length > 0
  ? solverPoints.map((p, i) => `${i === 0 ? 'M' : 'L'} ${getX(p.N).toFixed(2)} ${getY(p.our_best_metric!).toFixed(2)}`).join(' ')
  : '';

const newBestPoints = solverPoints.filter((p) => p.comparison_status === 'NEW_BEST');
const newBestCount = newBestPoints.length;
---

<div class="benchmark-curve-card bg-surface border border-hairline rounded-lg p-5 space-y-4">
  <!-- Header & Controls -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-4">
    <div>
      <h3 class="text-base font-bold text-slate-100 flex items-center gap-2">
        <span>Benchmark Curve (N vs. s)</span>
      </h3>
      <p class="text-xs text-slate-400 mt-0.5">
        Comparing Erich Friedman reference metrics against active solver best bounds.
      </p>
    </div>

    <!-- Quick stats tags -->
    <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
      <span class="px-2.5 py-1 rounded-md bg-canvas border border-hairline text-slate-300">
        N &in; [{minN}, {maxN}]
      </span>
      <span class="px-2.5 py-1 rounded-md bg-canvas border border-hairline text-slate-300">
        s &in; [{minVal.toFixed(2)}, {maxVal.toFixed(2)}]
      </span>
      {newBestCount > 0 ? (
        <span class="px-2.5 py-1 rounded-md bg-amber-500/10 text-amber-400 border border-amber-500/30 font-semibold">
          {newBestCount} Records Broken
        </span>
      ) : (
        <span class="px-2.5 py-1 rounded-md bg-canvas border border-hairline text-slate-400">
          0 Records Broken
        </span>
      )}
    </div>
  </div>

  <!-- SVG Chart Container -->
  <div class="relative w-full overflow-x-auto bg-canvas border border-hairline rounded-md p-3">
    <svg
      viewBox={`0 0 ${svgWidth} ${svgHeight}`}
      class="w-full h-auto min-w-[600px] overflow-visible select-none"
      aria-label={`Benchmark curve for ${familyName || familySlug}`}
    >
      <!-- Horizontal Grid Lines & Y-axis labels -->
      {yTicks.map((t) => (
        <g class="grid-y">
          <line
            x1={marginLeft}
            y1={t.y}
            x2={marginLeft + plotWidth}
            y2={t.y}
            stroke="rgba(255, 255, 255, 0.08)"
            stroke-width="1"
          />
          <text
            x={marginLeft - 10}
            y={t.y + 3.5}
            text-anchor="end"
            class="font-mono text-[10px] fill-slate-400"
          >
            {t.label}
          </text>
        </g>
      ))}

      <!-- Vertical Grid Lines & X-axis labels -->
      {xTicks.map((t) => (
        <g class="grid-x">
          <line
            x1={t.x}
            y1={marginTop}
            x2={t.x}
            y2={marginTop + plotHeight}
            stroke="rgba(255, 255, 255, 0.05)"
            stroke-width="1"
            stroke-dasharray="2,3"
          />
          <text
            x={t.x}
            y={marginTop + plotHeight + 16}
            text-anchor="middle"
            class="font-mono text-[10px] fill-slate-400"
          >
            {t.n}
          </text>
        </g>
      ))}

      <!-- Axes Hairlines -->
      <line
        x1={marginLeft}
        y1={marginTop}
        x2={marginLeft}
        y2={marginTop + plotHeight}
        stroke="#475569"
        stroke-width="1"
      />
      <line
        x1={marginLeft}
        y1={marginTop + plotHeight}
        x2={marginLeft + plotWidth}
        y2={marginTop + plotHeight}
        stroke="#475569"
        stroke-width="1"
      />

      <!-- Axis Titles -->
      <text
        x={marginLeft + plotWidth / 2}
        y={marginTop + plotHeight + 34}
        text-anchor="middle"
        class="font-mono text-[11px] fill-slate-400 font-semibold"
      >
        Instances (N)
      </text>

      <text
        transform={`rotate(-90)`}
        x={-(marginTop + plotHeight / 2)}
        y={18}
        text-anchor="middle"
        class="font-mono text-[11px] fill-slate-400 font-semibold"
      >
        Metric (s)
      </text>

      <!-- Erich Friedman Reference Series -->
      {refPathD && (
        <path
          d={refPathD}
          fill="none"
          stroke="#64748b"
          stroke-width="1.5"
          stroke-dasharray="4,3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      )}

      <!-- Solver Best Series -->
      {solverPathD && (
        <path
          d={solverPathD}
          fill="none"
          stroke="#0284c7"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      )}

      <!-- Erich Friedman Reference Points -->
      {refPoints.map((p) => {
        const cx = getX(p.N);
        const cy = getY(p.known_value!);
        return (
          <circle
            cx={cx}
            cy={cy}
            r="2.5"
            fill="#334155"
            stroke="#64748b"
            stroke-width="1"
            class="cursor-pointer"
          >
            <title>{`N=${p.N} | Erich Friedman Reference: s = ${p.known_value!.toFixed(6)}`}</title>
          </circle>
        );
      })}

      <!-- Solver Points (Cadmium for NEW_BEST) -->
      {solverPoints.map((p) => {
        const cx = getX(p.N);
        const cy = getY(p.our_best_metric!);
        const isNewBest = p.comparison_status === 'NEW_BEST';

        if (isNewBest) {
          return (
            <g class="new-best-marker cursor-pointer">
              <!-- Cadmium halo -->
              <circle
                cx={cx}
                cy={cy}
                r="6.5"
                fill="none"
                stroke="#f59e0b"
                stroke-width="1.25"
                stroke-opacity="0.45"
              />
              <!-- Solid cadmium marker -->
              <circle
                cx={cx}
                cy={cy}
                r="3.5"
                fill="#f59e0b"
                stroke="#ffffff"
                stroke-width="1.5"
              >
                <title>{`N=${p.N} | NEW RECORD BROKEN! Solver: s = ${p.our_best_metric!.toFixed(6)} (Ref: ${p.known_value?.toFixed(6) ?? 'None'})`}</title>
              </circle>
            </g>
          );
        }

        return (
          <circle
            cx={cx}
            cy={cy}
            r="2.5"
            fill="#0284c7"
            stroke="#38bdf8"
            stroke-width="1"
            class="cursor-pointer"
          >
            <title>{`N=${p.N} | Solver Best: s = ${p.our_best_metric!.toFixed(6)}`}</title>
          </circle>
        );
      })}
    </svg>
  </div>

  <!-- Legend -->
  <div class="flex flex-wrap items-center justify-between gap-4 pt-1 font-mono text-xs text-slate-300">
    <div class="flex flex-wrap items-center gap-5">
      <!-- Reference Legend -->
      <div class="flex items-center gap-2">
        <svg class="w-5 h-2" viewBox="0 0 20 8">
          <line x1="0" y1="4" x2="20" y2="4" stroke="#64748b" stroke-width="2" stroke-dasharray="3,2" />
          <circle cx="10" cy="4" r="2.5" fill="#334155" stroke="#64748b" stroke-width="1" />
        </svg>
        <span>Erich Friedman Reference</span>
      </div>

      <!-- Solver Best Legend -->
      <div class="flex items-center gap-2">
        <svg class="w-5 h-2" viewBox="0 0 20 8">
          <line x1="0" y1="4" x2="20" y2="4" stroke="#0284c7" stroke-width="2" />
          <circle cx="10" cy="4" r="2.5" fill="#0284c7" stroke="#38bdf8" stroke-width="1" />
        </svg>
        <span>Solver Best Bound</span>
      </div>

      <!-- New Record Legend -->
      <div class="flex items-center gap-2">
        <svg class="w-5 h-2" viewBox="0 0 20 8">
          <circle cx="10" cy="4" r="3.5" fill="#f59e0b" stroke="#ffffff" stroke-width="1" />
        </svg>
        <span class="text-amber-400 font-semibold">New Record Broken</span>
      </div>
    </div>

    <div class="text-[11px] text-slate-400">
      Hover data points to inspect numerical metrics
    </div>
  </div>
</div>
