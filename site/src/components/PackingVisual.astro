---
import { generatePackingSvgElements, type SolutionData } from '../lib/visualization/render_packing';

interface Props {
  solution: SolutionData;
  title?: string;
  fallbackInner?: string | number;
  fallbackContainer?: string | number;
}

const { solution, title, fallbackInner, fallbackContainer } = Astro.props;

// Merge fallbacks if missing in solution object
const mergedSolution = {
  ...solution,
  inner_token: solution.inner_token ?? solution.inner_sides ?? fallbackInner,
  container_token: solution.container_token ?? solution.container_sides ?? fallbackContainer,
};

const svgData = generatePackingSvgElements(mergedSolution);
---

{svgData ? (
  <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-col items-center shadow-lg">
    {title && <h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">{title}</h4>}
    <div class="w-full aspect-square max-w-[280px] relative flex items-center justify-center bg-slate-950/60 rounded-lg border border-slate-800/60 p-2">
      <svg viewBox={svgData.viewBox} class="w-full h-full transform scale-y-[-1] overflow-visible">
        <!-- Container Boundary -->
        {!svgData.isContainerCircle && svgData.containerVertices ? (
          <polygon
            points={svgData.containerVertices.map(p => `${p.x.toFixed(4)},${p.y.toFixed(4)}`).join(' ')}
            fill="none"
            stroke="#64748b"
            stroke-width="0.04"
            stroke-dasharray="0.1,0.1"
          />
        ) : (
          <circle
            cx="0"
            cy="0"
            r={svgData.S}
            fill="none"
            stroke="#64748b"
            stroke-width="0.04"
            stroke-dasharray="0.1,0.1"
          />
        )}

        <!-- Inner Shapes -->
        {svgData.shapes.map((shape) => {
          if (shape.isCircle) {
            return (
              <circle
                cx={shape.cx}
                cy={shape.cy}
                r="1"
                fill={shape.color}
                fill-opacity="0.4"
                stroke={shape.color}
                stroke-width="0.03"
              />
            );
          } else if (shape.vertices) {
            return (
              <polygon
                points={shape.vertices.map(p => `${p.x.toFixed(4)},${p.y.toFixed(4)}`).join(' ')}
                fill={shape.color}
                fill-opacity="0.4"
                stroke={shape.color}
                stroke-width="0.03"
              />
            );
          }
        })}
      </svg>
    </div>
    <div class="mt-3 flex items-center justify-between w-full text-[11px] text-slate-400 border-t border-slate-800/60 pt-2 font-mono">
      <span>N = <strong class="text-indigo-400">{solution.N}</strong></span>
      <span>Final Metric (s) = <strong class="text-emerald-400">{svgData.finalMetric.toFixed(4)}</strong></span>
    </div>
  </div>
) : (
  <div class="text-xs text-slate-500 italic py-4 text-center">No visualization available</div>
)}
