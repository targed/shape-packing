---
import { generatePackingSvgElements, type SolutionData } from '../lib/visualization/render_packing';

interface Props {
  solution: SolutionData;
  title?: string;
  fallbackInner?: string | number;
  fallbackContainer?: string | number;
}

const { solution, title, fallbackInner, fallbackContainer } = Astro.props;

// Merge fallbacks if missing in solution object
const mergedSolution = {
  ...solution,
  inner_token: solution.inner_token ?? solution.inner_sides ?? fallbackInner,
  container_token: solution.container_token ?? solution.container_sides ?? fallbackContainer,
};

const svgData = generatePackingSvgElements(mergedSolution);
const displayTitle = title || (solution as any).problem_id || (solution.N !== undefined ? `N=${solution.N}` : 'Solution');
const fileStem = displayTitle.toLowerCase().replace(/[^a-z0-9_-]/g, '_');
const exportJsonPayload = JSON.stringify(
  {
    ...(solution as any).problem_id ? { problem_id: (solution as any).problem_id } : {},
    N: solution.N ?? svgData?.shapes.length ?? 0,
    S: svgData?.S ?? solution.S ?? null,
    final_metric: svgData?.finalMetric ?? solution.final_metric ?? null,
    inner_token: mergedSolution.inner_token,
    container_token: mergedSolution.container_token,
    values: solution.values ?? [],
  },
  null,
  2
);
---

{svgData ? (
  <div class="packing-plate bg-surface border border-hairline rounded-lg p-3.5 space-y-2.5 flex flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <span class="font-mono text-xs text-slate-300 font-semibold truncate" title={displayTitle}>
        {displayTitle}
      </span>
      <span class="font-mono text-[10px] text-slate-400 uppercase tracking-wider">Plate</span>
    </div>

    <!-- Internal Stage -->
    <div class="w-full aspect-square relative flex items-center justify-center bg-canvas border border-hairline rounded-md p-2 overflow-hidden">
      <!-- Dimension Tags -->
      <div class="absolute top-1.5 left-2 pointer-events-none font-mono text-[9px] text-slate-400 tracking-wider select-none z-10">
        (0, 0)
      </div>
      <div class="absolute bottom-1.5 right-2 pointer-events-none font-mono text-[9px] text-slate-400 tracking-wider select-none z-10">
        {svgData.spanX.toFixed(2)} &times; {svgData.spanY.toFixed(2)}
      </div>

      <!-- Vector SVG -->
      <svg
        viewBox={svgData.viewBox}
        class="packing-svg w-full h-full overflow-visible"
      >
        <!-- Origin crosshairs: 2 dashed hairline lines across the origin (0, 0) -->
        <g class="crosshairs" opacity="0.4">
          <line
            x1={svgData.minX}
            y1="0"
            x2={svgData.maxX}
            y2="0"
            stroke="#64748b"
            stroke-width="0.02"
            stroke-dasharray="0.1,0.1"
          />
          <line
            x1="0"
            y1={svgData.minY}
            x2="0"
            y2={svgData.maxY}
            stroke="#64748b"
            stroke-width="0.02"
            stroke-dasharray="0.1,0.1"
          />
        </g>

        <!-- Container Boundary -->
        {svgData.containerArcPath ? (
          <path
            d={svgData.containerArcPath}
            fill="none"
            stroke="#64748b"
            stroke-width="0.04"
            stroke-dasharray="0.1,0.1"
          />
        ) : !svgData.isContainerCircle && svgData.containerVertices ? (
          <polygon
            points={svgData.containerVertices.map(p => `${p.x.toFixed(4)},${p.y.toFixed(4)}`).join(' ')}
            fill="none"
            stroke="#64748b"
            stroke-width="0.04"
            stroke-dasharray="0.1,0.1"
          />
        ) : (
          <circle
            cx="0"
            cy="0"
            r={svgData.S}
            fill="none"
            stroke="#64748b"
            stroke-width="0.04"
            stroke-dasharray="0.1,0.1"
          />
        )}

        <!-- Packed Shapes -->
        {svgData.shapes.map((shape) => {
          if (shape.isCircle) {
            return (
              <circle
                cx={shape.cx}
                cy={shape.cy}
                r="1"
                fill={shape.color}
                fill-opacity="0.45"
                stroke={shape.color}
                stroke-width="0.03"
              />
            );
          } else if (shape.vertices) {
            return (
              <polygon
                points={shape.vertices.map(p => `${p.x.toFixed(4)},${p.y.toFixed(4)}`).join(' ')}
                fill={shape.color}
                fill-opacity="0.45"
                stroke={shape.color}
                stroke-width="0.03"
              />
            );
          }
        })}
      </svg>
    </div>

    <!-- Footer -->
    <div class="flex items-center justify-between pt-1 border-t border-hairline font-mono text-xs text-slate-400">
      <div class="flex items-center gap-2">
        <span>N = <strong class="text-blueprint-light font-semibold">{solution.N ?? svgData.shapes.length}</strong></span>
        <span class="text-slate-600">&bull;</span>
        <span>s = <strong class="text-verify-light font-semibold">{svgData.finalMetric.toFixed(4)}</strong></span>
      </div>
      <div class="flex items-center gap-1.5">
        <button
          type="button"
          class="export-svg-btn text-[10px] font-mono px-2 py-0.5 rounded-md bg-surface-elevated hover:bg-surface-hover text-slate-300 border border-hairline transition-colors flex items-center gap-1.5 cursor-pointer"
          data-filename={`packing-${fileStem}.svg`}
          title="Export SVG"
        >
          <svg class="w-3 h-3 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span>Export SVG</span>
        </button>
        <button
          type="button"
          class="export-json-btn text-[10px] font-mono px-2 py-0.5 rounded-md bg-surface-elevated hover:bg-surface-hover text-slate-300 border border-hairline transition-colors flex items-center gap-1.5 cursor-pointer"
          data-filename={`packing-${fileStem}.json`}
          data-json={exportJsonPayload}
          title="Export JSON"
        >
          <svg class="w-3 h-3 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span>Export JSON</span>
        </button>
      </div>
    </div>
  </div>
) : (
  <div class="bg-surface border border-hairline rounded-lg p-3.5 text-center text-xs text-slate-400 font-mono">
    No visualization available
  </div>
)}

<script>
  import { initPackingExports } from '../lib/visualization/packing_export';
  initPackingExports();
</script>
