---
// site/src/components/LeaderboardTable.astro
---

<div class="space-y-4">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <h2 class="text-xl font-bold font-display text-slate-100 tracking-tight">Active Contributors</h2>
      <span id="leaderboard-count-badge" class="px-2.5 py-0.5 rounded-md text-xs font-mono bg-surface-elevated text-blueprint-light border border-hairline">
        0 Volunteers
      </span>
    </div>
    <button
      id="btn-refresh-leaderboard"
      class="bg-surface-elevated hover:bg-surface-hover text-slate-300 border border-hairline rounded-md font-mono text-xs px-3 py-1.5 flex items-center gap-1.5 cursor-pointer transition-colors"
    >
      <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
      </svg>
      <span>Refresh Rankings</span>
    </button>
  </div>

  <div class="overflow-x-auto rounded-lg border border-hairline bg-surface">
    <table class="w-full text-left text-xs text-slate-300">
      <thead class="bg-surface-elevated uppercase text-slate-400 border-b border-hairline font-semibold tracking-wider font-mono">
        <tr>
          <th class="px-4 py-3.5 text-center w-16">Rank</th>
          <th class="px-5 py-3.5">Volunteer</th>
          <th class="px-5 py-3.5 text-right">Compute Attempts</th>
          <th class="px-5 py-3.5 text-right text-cadmium-light">Records Broken</th>
        </tr>
      </thead>
      <tbody id="leaderboard-tbody" class="divide-y divide-hairline font-mono">
        <tr>
          <td colspan="4" class="px-6 py-8 text-center text-slate-400 font-mono text-xs">
            Querying coordinator for active rankings...
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<script>
  import { fetchLeaderboard } from '../lib/api';

  const tbody = document.getElementById('leaderboard-tbody');
  const countBadge = document.getElementById('leaderboard-count-badge');
  const refreshBtn = document.getElementById('btn-refresh-leaderboard');

  async function renderLeaderboard() {
    const res = await fetchLeaderboard();
    if (!tbody) return;

    if (!res.ok || !res.data || res.data.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="4" class="px-6 py-8 text-center text-slate-400 font-mono text-xs">
            ${res.ok ? 'No volunteer records registered yet. Start a native or browser worker to appear here.' : 'Coordinator is offline. Connect to coordinator to view live rankings.'}
          </td>
        </tr>
      `;
      if (countBadge) countBadge.textContent = '0 Volunteers';
      return;
    }

    if (countBadge) {
      countBadge.textContent = `${res.data.length} Volunteers`;
    }

    tbody.innerHTML = res.data.map((row, index) => {
      const rank = index + 1;
      let rankBadge = `<span class="px-2 py-0.5 rounded-md text-xs font-mono text-slate-400">#${rank}</span>`;
      if (rank === 1) {
        rankBadge = `<span class="px-2 py-0.5 rounded-md text-xs font-mono font-bold bg-cadmium/15 text-cadmium-light border border-cadmium/30">#1</span>`;
      } else if (rank === 2) {
        rankBadge = `<span class="px-2 py-0.5 rounded-md text-xs font-mono font-bold bg-surface-elevated text-slate-200 border border-hairline">#2</span>`;
      } else if (rank === 3) {
        rankBadge = `<span class="px-2 py-0.5 rounded-md text-xs font-mono font-bold bg-surface-elevated text-slate-300 border border-hairline">#3</span>`;
      }

      return `
        <tr class="hover:bg-surface-elevated/40 transition-colors border-b border-hairline last:border-b-0">
          <td class="px-4 py-3.5 text-center">${rankBadge}</td>
          <td class="px-5 py-3.5 font-mono font-semibold text-slate-100 flex items-center gap-2">
            <span class="w-2 h-2 rounded-md bg-verify shrink-0"></span>
            <span>${escapeHtml(row.username)}</span>
          </td>
          <td class="px-5 py-3.5 text-right font-mono text-slate-200">${(row.total_attempts ?? 0).toLocaleString()}</td>
          <td class="px-5 py-3.5 text-right font-mono font-bold text-cadmium-light">${(row.records_broken ?? 0).toLocaleString()}</td>
        </tr>
      `;
    }).join('');
  }

  function escapeHtml(text: string): string {
    return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  if (refreshBtn) {
    refreshBtn.addEventListener('click', renderLeaderboard);
  }

  renderLeaderboard();
</script>
