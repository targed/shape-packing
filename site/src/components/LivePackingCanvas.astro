---
// site/src/components/LivePackingCanvas.astro
---

<div class="relative w-full aspect-square max-w-md mx-auto bg-slate-950 rounded-2xl overflow-hidden border border-slate-800 shadow-2xl flex flex-col items-center justify-center p-2">
  <canvas id="live-canvas" width="400" height="400" class="w-full h-full rounded-xl bg-slate-900/60"></canvas>
  
  <div class="absolute top-4 left-4 flex items-center gap-2 bg-slate-950/80 backdrop-blur-md px-3 py-1.5 rounded-lg border border-slate-800 text-xs font-mono text-slate-300">
    <span id="canvas-status-dot" class="w-2 h-2 rounded-full bg-slate-500"></span>
    <span id="canvas-status-label">Worker Idle</span>
  </div>

  <div id="canvas-inspect-banner" class="hidden absolute top-4 right-4 flex items-center gap-2 bg-indigo-950/90 backdrop-blur-md px-3 py-1.5 rounded-lg border border-indigo-700/80 text-xs font-mono text-indigo-300 shadow-xl z-10">
    <span class="w-2 h-2 rounded-full bg-indigo-400 animate-ping"></span>
    <span>Inspecting History</span>
    <button id="btn-resume-live" class="ml-1 px-2 py-0.5 rounded bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-[10px] cursor-pointer transition">
      Resume Live
    </button>
  </div>

  <div id="canvas-overlay" class="absolute bottom-4 left-4 right-4 flex justify-between items-center bg-slate-950/85 backdrop-blur-md px-3 py-2 rounded-xl border border-slate-800 text-xs font-mono">
    <div class="flex flex-col">
      <span class="text-[10px] uppercase text-slate-500 font-semibold">Current Problem</span>
      <span id="canvas-problem-name" class="font-bold text-slate-200">None</span>
    </div>
    <div class="flex flex-col text-right">
      <span class="text-[10px] uppercase text-slate-500 font-semibold">Scale (s)</span>
      <span id="canvas-scale-value" class="font-bold text-amber-400">0.00000</span>
    </div>
  </div>
</div>

<script>
  import {
    parseShapeToken,
    getUnitShapeVertices,
    getRegularPolygonVertices,
    getContainerRotationOffset,
    inverseFriedmanMetric,
    transformPoint,
    type PolygonPoint
  } from '../lib/visualization/render_packing';

  const canvas = document.getElementById('live-canvas') as HTMLCanvasElement;
  const statusDot = document.getElementById('canvas-status-dot');
  const statusLabel = document.getElementById('canvas-status-label');
  const problemName = document.getElementById('canvas-problem-name');
  const scaleValue = document.getElementById('canvas-scale-value');
  const inspectBanner = document.getElementById('canvas-inspect-banner');
  const resumeLiveBtn = document.getElementById('btn-resume-live');
  const ctx = canvas?.getContext('2d');

  const palette = [
    '#6366f1', '#8b5cf6', '#ec4899', '#f43f5e', '#10b981',
    '#06b6d4', '#3b82f6', '#f59e0b', '#84cc16', '#a855f7'
  ];

  let currentInnerToken = '3';
  let currentContainerToken = 'CIRCLE';
  let isInspecting = false;
  let lastLiveDetail: any = null;

  resumeLiveBtn?.addEventListener('click', () => {
    isInspecting = false;
    if (inspectBanner) inspectBanner.classList.add('hidden');
    if (lastLiveDetail) {
      renderPackingState(lastLiveDetail);
    }
  });

  function drawEmptyCanvas() {
    if (!ctx || !canvas) return;
    const w = canvas.width;
    const h = canvas.height;
    ctx.clearRect(0, 0, w, h);

    // Subtle grid lines
    ctx.strokeStyle = '#1e293b';
    ctx.lineWidth = 1;
    for (let x = 0; x < w; x += 40) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, h);
      ctx.stroke();
    }
    for (let y = 0; y < h; y += 40) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(w, y);
      ctx.stroke();
    }

    // Centered placeholder text
    ctx.fillStyle = '#475569';
    ctx.font = '13px JetBrains Mono, monospace';
    ctx.textAlign = 'center';
    ctx.fillText('Press "Start Crunching" to begin', w / 2, h / 2);
  }

  drawEmptyCanvas();

  function renderPackingState(detail: any) {
    const { problem, n, s, container_s, coordinates, inner_token, container_token, status, is_inspect } = detail;

    if (inner_token) currentInnerToken = inner_token;
    if (container_token) currentContainerToken = container_token;

    if (problemName) problemName.textContent = problem || 'Active';
    if (scaleValue) scaleValue.textContent = typeof s === 'number' && !isNaN(s) ? s.toFixed(5) : '—';

    if (statusLabel && status) {
      statusLabel.textContent = status;
    }
    if (statusDot) {
      statusDot.className = is_inspect
        ? 'w-2 h-2 rounded-full bg-indigo-400'
        : 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse';
    }

    if (!ctx || !canvas) return;

    const w = canvas.width;
    const h = canvas.height;

    ctx.clearRect(0, 0, w, h);

    // Grid background
    ctx.strokeStyle = '#1e293b';
    ctx.lineWidth = 1;
    for (let x = 0; x < w; x += 40) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, h);
      ctx.stroke();
    }
    for (let y = 0; y < h; y += 40) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(w, y);
      ctx.stroke();
    }

    // Determine actual geometric container scale factor S
    let S = typeof container_s === 'number' && container_s > 0 ? container_s : null;
    if (!S && typeof s === 'number' && s > 0) {
      S = inverseFriedmanMetric(s, currentInnerToken, currentContainerToken);
    }
    if (!S || isNaN(S) || S <= 0) S = 2.0;

    const cToken = parseShapeToken(currentContainerToken || 'CIRCLE');
    const isContainerCircle = cToken === 'CIRCLE';
    const rot = getContainerRotationOffset(cToken);
    const cosR = Math.cos(rot);
    const sinR = Math.sin(rot);

    // Build container boundary vertices
    let containerVertices: PolygonPoint[] | null = null;
    if (!isContainerCircle) {
      const unitContainer = getUnitShapeVertices(cToken) || getRegularPolygonVertices(4, 1.0, 0);
      containerVertices = unitContainer.map((pt) => ({
        x: (pt.x * cosR - pt.y * sinR) * S,
        y: (pt.x * sinR + pt.y * cosR) * S,
      }));
    }

    // Build inner shape geometries
    const iToken = parseShapeToken(currentInnerToken || '3');
    const isInnerCircle = iToken === 'CIRCLE';
    const unitInner = isInnerCircle ? null : (getUnitShapeVertices(iToken) || getRegularPolygonVertices(3, 1.0, 0));

    const N = n || (coordinates ? Math.floor(coordinates.length / 3) : 0);
    interface PreparedShape {
      cx: number;
      cy: number;
      vertices: PolygonPoint[] | null;
      color: string;
    }
    const shapes: PreparedShape[] = [];

    if (coordinates && coordinates.length >= 3 && N > 0) {
      for (let i = 0; i < N; i++) {
        const rawX = coordinates[i * 3] || 0;
        const rawY = coordinates[i * 3 + 1] || 0;
        const rawAngle = coordinates[i * 3 + 2] || 0;

        const cx = rawX * cosR - rawY * sinR;
        const cy = rawX * sinR + rawY * cosR;
        const angle = rawAngle + rot;

        let shapeVertices: PolygonPoint[] | null = null;
        if (!isInnerCircle && unitInner) {
          shapeVertices = unitInner.map((pt) => transformPoint(pt, cx, cy, angle));
        }

        shapes.push({
          cx,
          cy,
          vertices: shapeVertices,
          color: palette[i % palette.length],
        });
      }
    }

    // Calculate bounding box derived from container boundary
    let minX = isContainerCircle ? -S : Infinity;
    let maxX = isContainerCircle ? S : -Infinity;
    let minY = isContainerCircle ? -S : Infinity;
    let maxY = isContainerCircle ? S : -Infinity;

    if (containerVertices) {
      for (const pt of containerVertices) {
        if (pt.x < minX) minX = pt.x;
        if (pt.x > maxX) maxX = pt.x;
        if (pt.y < minY) minY = pt.y;
        if (pt.y > maxY) maxY = pt.y;
      }
    }

    const spanX = maxX - minX || 2 * S || 1;
    const spanY = maxY - minY || 2 * S || 1;
    const pad = Math.max(spanX, spanY) * 0.08;

    const viewBoxMinX = minX - pad;
    const viewBoxMaxX = maxX + pad;
    const viewBoxMinY = minY - pad;
    const viewBoxMaxY = maxY + pad;

    const boxW = viewBoxMaxX - viewBoxMinX;
    const boxH = viewBoxMaxY - viewBoxMinY;
    const midX = (viewBoxMinX + viewBoxMaxX) / 2;
    const midY = (viewBoxMinY + viewBoxMaxY) / 2;

    const viewScale = Math.min((w * 0.90) / boxW, (h * 0.90) / boxH);

    function toCanvasX(x: number): number {
      return w / 2 + (x - midX) * viewScale;
    }

    function toCanvasY(y: number): number {
      return h / 2 - (y - midY) * viewScale; // Inverted Y-axis: Cartesian +Y maps UP
    }

    // Draw container boundary
    ctx.strokeStyle = '#38bdf8';
    ctx.lineWidth = 2.5;

    if (isContainerCircle) {
      ctx.beginPath();
      const cX = toCanvasX(0);
      const cY = toCanvasY(0);
      const r = S * viewScale;
      ctx.arc(cX, cY, r, 0, Math.PI * 2);
      ctx.stroke();
    } else if (containerVertices) {
      ctx.beginPath();
      containerVertices.forEach((pt, i) => {
        const px = toCanvasX(pt.x);
        const py = toCanvasY(pt.y);
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      });
      ctx.closePath();
      ctx.stroke();
    }

    // Draw inner shapes or placeholder HUD
    if (!coordinates || coordinates.length < 3 || shapes.length === 0) {
      ctx.fillStyle = '#64748b';
      ctx.font = '12px JetBrains Mono, monospace';
      ctx.textAlign = 'center';
      const shapeDesc = `${n || ''} ${currentInnerToken} in ${currentContainerToken}`;
      ctx.fillText(`Optimizing ${shapeDesc}`, w / 2, h / 2 - 8);
      ctx.fillStyle = '#475569';
      ctx.font = '10px JetBrains Mono, monospace';
      ctx.fillText('Searching configuration space...', w / 2, h / 2 + 14);
    } else {
      for (const shape of shapes) {
        ctx.fillStyle = `${shape.color}44`;
        ctx.strokeStyle = shape.color;
        ctx.lineWidth = 1.5;

        if (isInnerCircle) {
          const cx = toCanvasX(shape.cx);
          const cy = toCanvasY(shape.cy);
          const r = 1.0 * viewScale;
          ctx.beginPath();
          ctx.arc(cx, cy, r, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
        } else if (shape.vertices) {
          ctx.beginPath();
          shape.vertices.forEach((pt, idx) => {
            const px = toCanvasX(pt.x);
            const py = toCanvasY(pt.y);
            if (idx === 0) ctx.moveTo(px, py);
            else ctx.lineTo(px, py);
          });
          ctx.closePath();
          ctx.fill();
          ctx.stroke();
        }
      }
    }
  }

  window.addEventListener('update-live-packing', (e: Event) => {
    const customEvent = e as CustomEvent;
    const detail = customEvent.detail;

    if (detail.is_inspect) {
      isInspecting = true;
      if (inspectBanner) inspectBanner.classList.remove('hidden');
      renderPackingState(detail);
      return;
    }

    lastLiveDetail = detail;
    if (isInspecting) {
      // User is inspecting a past problem from history: keep canvas frozen on inspected state
      return;
    }

    renderPackingState(detail);
  });
</script>
